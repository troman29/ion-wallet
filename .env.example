NODE_ENV=development

# Default: create a 12-word multichain wallet; set to 0 for a 24-word ION-only wallet
CREATE_MULTICHAIN_WALLET=1
# Exchange is hidden until the ION bridge flow is implemented
ENABLE_EXCHANGE=0

TONCENTER_MAINNET_URL=https://api.mainnet.ice.io
TONCENTER_MAINNET_KEY=
TONCENTER_TESTNET_URL=https://api.testnet.ice.io
TONCENTER_TESTNET_KEY=
# Optional; configure only for an ION-compatible proxy service
PROXY_HOSTS=
BRILLIANT_API_BASE_URL=
PROXY_API_BASE_URL=
# Disabled by default, including when unset or empty; set to 0 only for a compatible backend
NO_PENDING_ACTIVITIES=1
NO_WEBSOCKET=1
# ION trace emulation is unavailable; use legacy fee estimation, including TON Connect
NO_TRACE_EMULATION=1
TEST_MNEMONIC=
TEST_PASSWORD=
CSP_CONNECT_SRC_EXTRA_URL=

WALLET_CONNECT_PROJECT_ID=
